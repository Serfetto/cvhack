# Хакатон — доступ к стенду. Логин и пароль выдаются отдельно.
client
dev tun
proto tcp-client
remote 83.220.57.3 1194
nobind
persist-key
persist-tun
resolv-retry infinite
remote-cert-tls server
tls-version-max 1.2
cipher AES-256-CBC
data-ciphers AES-256-CBC
auth SHA1
auth-user-pass
auth-nocache
pull-filter ignore redirect-gateway
route 10.0.114.0 255.255.255.0
verb 3

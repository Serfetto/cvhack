          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le,stage) (rate(inference_seconds_bucket[1m])))",
          "legendFormat": "p50 {{stage}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le,stage) (rate(inference_seconds_bucket[1m])))",

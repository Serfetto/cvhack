# Скопировать в .env и поправить при необходимости: cp .env.example .env

# --- инфраструктура ---
POSTGRES_USER=linq
POSTGRES_PASSWORD=linq
POSTGRES_DB=linq
REDIS_PASSWORD=linq-redis
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=linq

# Порт, на котором шлюз (Traefik) слушает на хосте
GATEWAY_PORT=8080

# --- auth ---
# Пароль всех демо-пользователей (admin, hse, master, operator, manager, auditor)
DEMO_PASSWORD=demo
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7

# --- инференс ---
# synthetic — фейковый человек ходит по кадру (без ML), null — пустые детекции,
# onnx — CPU (модели ML в data/models), broker — LinQ через RabbitMQ/Jupyter;
# remote — отдельный HTTP-воркер, pytpu — прямой доступ к устройству (в этом Jupyter недоступен)
INFERENCE_BACKEND=synthetic
# Куда переключаться, если основной бэкенд упал: onnx | synthetic | null | none
INFERENCE_FALLBACK=none
# Адрес tpu-worker на стенде (для INFERENCE_BACKEND=remote)
REMOTE_URL=http://10.0.114.10:8000
# Для INFERENCE_BACKEND=broker. Jupyter-воркер использует те же URL и имя очереди.
BROKER_URL=amqp://guest:guest@10.0.114.30:5672/%2F
BROKER_REQUEST_QUEUE=cvhack12731.jpeg
BROKER_TIMEOUT_S=3.0
# Кадр старше этого не отправляем в модель: важнее свежие кадры, чем полные
MAX_FRAME_AGE_S=2.0
# Сколько шардов у потока кадров frames:{shard}
FRAME_SHARDS=1

# --- аналитика ---
# bytetrack (supervision) | iou (простой трекер без зависимостей)
TRACKER=bytetrack

# --- события ---
# Токен для приёма нарушений по HTTP со стенда (режим B): заголовок X-Ingest-Token
INGEST_TOKEN=change-me
# Эскалация: через сколько минут непринятое событие уходит начальнику
ESCALATE_CRITICAL_MIN=2
ESCALATE_HIGH_MIN=5
ESCALATE_MEDIUM_MIN=15
ESCALATE_LOW_MIN=60

# --- уведомления ---
# Пусто — Telegram выключен
TELEGRAM_BOT_TOKEN=
